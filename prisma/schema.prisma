generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  STAKEHOLDER
  QA
}

enum TaskStatus {
  DRAFT
  READY
  IN_PROGRESS
  BLOCKED
  PASSED
  FAILED
  DEPLOYED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum StepResult {
  PASSED
  FAILED
  CONDITIONAL
}

enum ActivityType {
  TASK_ASSIGNED
  STATUS_CHANGED
  COMMENT_ADDED
  SIGNED_OFF
  DEPLOYED
}

enum TaskHistoryAction {
  TASK_CREATED
  TASK_UPDATED
  STATUS_CHANGED
  STEP_CREATED
  STEP_UPDATED
  STEP_DELETED
  COMMENT_ADDED
  SIGNED_OFF
  DEPLOYED
  TASK_DELETED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         UserRole
  countryCode  String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  mustChangePassword Boolean @default(true)
  notifyOnAssignmentEmail Boolean @default(true)
  notifyOnReminderEmail   Boolean @default(true)
  notifyOnMentionInbox    Boolean @default(true)
  notifyOnSignoffEmail    Boolean @default(true)
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedTasks Task[]   @relation("TaskAssignee")
  updatedTasks  Task[]   @relation("TaskUpdatedBy")
  signedOffTasks Task[]  @relation("TaskSignedOffBy")
  activities     Activity[] @relation("ActivityActor")
  taskHistories  TaskHistory[]
  activityReads  ActivityRead[]
  commentReads   CommentRead[]
  comments      Comment[]
  portalSettingsUpdated PortalSetting[]
  productAccesses UserProductAccess[]

  sitTasksAssigned    SitTask[]        @relation("SitTaskAssignee")
  sitTasksSignedOff   SitTask[]        @relation("SitTaskSignedOffBy")
  sitTasksUpdated     SitTask[]        @relation("SitTaskUpdatedBy")
  sitCasesAcknowledged SitTestCase[]   @relation("SitCaseAcknowledgedBy")
  sitHistoryEntries   SitTaskHistory[] @relation("SitHistoryActor")
  draftTasksReviewed  DraftTask[]      @relation("DraftTaskReviewedBy")
}

model Product {
  id               String   @id @default(cuid())
  name             String   @unique
  slug             String   @unique
  isActive         Boolean  @default(true)
  jiraProjectKey              String?
  jiraPullStatuses            String[] @default([])
  jiraInUatTransition         String?
  jiraReadyToDeployTransition  String?
  jiraReadyForTestingTransition String?
  jiraTestingTransition         String?
  jiraSitDoneTransition         String?
  jiraBaseUrl                   String?
  jiraEmail                   String?
  jiraToken                   String?   // encrypted at rest
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  modules               Module[]
  targetSystems         TargetSystem[]
  tasks                 Task[]
  userAccesses          UserProductAccess[]
  notificationConfigs   NotificationConfig[]
  sitTasks              SitTask[]
  draftTasks            DraftTask[]
}

model Country {
  code      String   @id
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]
  notificationConfigs NotificationConfig[]
  sitTaskCountries    SitTaskCountry[]
  sitTestCaseCountryResults SitTestCaseCountryResult[]
}

model Module {
  id        String   @id @default(cuid())
  productId String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
}

model TargetSystem {
  id        String   @id @default(cuid())
  productId String
  name      String
  baseUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([productId, name])
}

model UserProductAccess {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, createdAt])
}

model Task {
  id          String       @id @default(cuid())
  taskGroupId String?
  title       String
  description String?
  jiraTicket          String?
  jiraTicketVerified  Boolean  @default(false)
  eodTicket           String?
  crNumber            String?
  developer   String?
  status      TaskStatus
  priority    TaskPriority
  countryCode String
  productId   String
  module      String?
  targetSystemId String?
  assigneeId  String?
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  updatedById String?
  signedOffAt DateTime?
  signedOffById String?
  signatureData String?
  sitSignedOffAt DateTime?
  sitComment     String?

  country      Country       @relation(fields: [countryCode], references: [code])
  product      Product       @relation(fields: [productId], references: [id])
  targetSystem TargetSystem? @relation(fields: [targetSystemId], references: [id])
  assignee     User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  updatedBy    User?         @relation("TaskUpdatedBy", fields: [updatedById], references: [id])
  signedOffBy  User?         @relation("TaskSignedOffBy", fields: [signedOffById], references: [id])
  comments     Comment[]
  steps        TaskStep[]
  activities   Activity[]

  @@index([assigneeId, updatedAt])
  @@index([countryCode, updatedAt])
  @@index([status, updatedAt])
  @@index([countryCode, status, updatedAt])
  @@index([dueDate])
  @@index([taskGroupId, updatedAt])
  @@index([productId, updatedAt])
  @@index([productId, status, updatedAt])
  @@index([jiraTicket])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  stepOrder Int?
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id])
  author User @relation(fields: [authorId], references: [id])
  reads  CommentRead[]

  @@index([taskId, createdAt])
  @@index([taskId, stepOrder, createdAt])
}

model CommentRead {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  readAt    DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId, readAt])
}

model TaskStep {
  id             String   @id @default(cuid())
  taskId         String
  order          Int
  description    String
  expectedResult String
  testData       String?
  actualResult   String?
  isPassed       Boolean?
  stepResult     StepResult?
  conditionalReason String?
  attachments    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id])

  @@index([taskId, order])
}

model PortalSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  message     String
  taskId      String?
  actorId     String?
  countryCode String?
  createdAt   DateTime     @default(now())

  task      Task?          @relation(fields: [taskId], references: [id])
  actor     User?          @relation("ActivityActor", fields: [actorId], references: [id])
  reads     ActivityRead[]

  @@index([createdAt])
  @@index([countryCode])
  @@index([countryCode, createdAt])
}

model ActivityRead {
  id         String   @id @default(cuid())
  activityId String
  userId     String
  readAt     DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([userId, readAt])
}

model NotificationConfig {
  id                 String   @id @default(cuid())
  productId          String
  countryCode        String
  teamsWebhookUrl    String?
  isActive           Boolean  @default(false)
  notifyTaskAssigned Boolean  @default(true)
  notifyReminder     Boolean  @default(true)
  notifySignedOff    Boolean  @default(true)
  notifyFailedStep   Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryCode], references: [code], onDelete: Cascade)

  @@unique([productId, countryCode])
}

model TaskHistory {
  id        String            @id @default(cuid())
  taskId    String
  actorId   String?
  action    TaskHistoryAction
  message   String
  before    Json?
  after     Json?
  metadata  Json?
  createdAt DateTime          @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([actorId, createdAt])
}

// ─── SIT Portal Enums ────────────────────────────────────────────────────────

enum SitTaskStatus {
  DRAFT
  READY
  IN_PROGRESS
  SIGNED_OFF
}

enum SitCaseStatus {
  NOT_STARTED
  PASS
  CONDITIONAL
  FAIL
  BLOCKED
}

enum SitEvidenceType {
  IMAGE
  JAM_LINK
}

enum DraftTaskStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SitHistoryAction {
  TASK_CREATED
  TASK_PUBLISHED
  STATUS_CHANGED
  TEST_CASE_ADDED
  TEST_CASE_MODIFIED
  TEST_CASE_REMOVED
  TEST_CASE_RESULT_RECORDED
  CONDITIONAL_ACKNOWLEDGED
  DEFECT_LINKED
  DEFECT_UNLINKED
  EVIDENCE_ADDED
  SCOPE_NOTE_ADDED
  SIGNED_OFF
}

// ─── SIT Portal Models ────────────────────────────────────────────────────────

model SitTask {
  id            String        @id @default(cuid())
  sprintName    String
  jiraTicket    String
  title         String
  productId     String
  module        String?
  environment   String?
  status        SitTaskStatus @default(DRAFT)
  assigneeId    String?
  signedOffAt   DateTime?
  signedOffById String?
  signatureData String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  updatedById   String?

  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  assignee    User?            @relation("SitTaskAssignee", fields: [assigneeId], references: [id])
  signedOffBy User?            @relation("SitTaskSignedOffBy", fields: [signedOffById], references: [id])
  updatedBy   User?            @relation("SitTaskUpdatedBy", fields: [updatedById], references: [id])
  countries   SitTaskCountry[]
  testCases   SitTestCase[]
  history     SitTaskHistory[]

  @@unique([jiraTicket, productId])
  @@index([productId, status])
  @@index([assigneeId, status])
}

model SitTaskCountry {
  sitTaskId   String
  countryCode String
  sitTask     SitTask @relation(fields: [sitTaskId], references: [id], onDelete: Cascade)
  country     Country @relation(fields: [countryCode], references: [code])
  @@id([sitTaskId, countryCode])
}

model SitTestCase {
  id                    String        @id @default(cuid())
  sitTaskId             String
  seqId                 Int
  priority              String?
  category              String?
  name                  String
  description           String?
  steps                 String?
  expectedResult        String?
  testData              String?
  actualResult          String?
  status                SitCaseStatus @default(NOT_STARTED)
  testerName            String?
  testedAt              DateTime?
  conditionalNote       String?
  adminAcknowledgedAt   DateTime?
  adminAcknowledgedById String?
  splitByCountry        Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  sitTask             SitTask                    @relation(fields: [sitTaskId], references: [id], onDelete: Cascade)
  adminAcknowledgedBy User?                      @relation("SitCaseAcknowledgedBy", fields: [adminAcknowledgedById], references: [id])
  evidence            SitEvidence[]
  defects             SitDefect[]
  countryResults      SitTestCaseCountryResult[]

  @@index([sitTaskId, seqId])
}

model SitTestCaseCountryResult {
  id            String        @id @default(cuid())
  sitTestCaseId String
  countryCode   String
  status        SitCaseStatus @default(NOT_STARTED)
  actualResult  String?
  testerName    String?
  testedAt      DateTime?

  testCase SitTestCase @relation(fields: [sitTestCaseId], references: [id], onDelete: Cascade)
  country  Country     @relation(fields: [countryCode], references: [code])

  @@unique([sitTestCaseId, countryCode])
}

model SitEvidence {
  id            String          @id @default(cuid())
  sitTestCaseId String
  type          SitEvidenceType
  url           String?
  imageData     String?
  filename      String?
  createdAt     DateTime        @default(now())

  testCase SitTestCase @relation(fields: [sitTestCaseId], references: [id], onDelete: Cascade)
}

model SitDefect {
  id            String   @id @default(cuid())
  sitTestCaseId String
  jiraKey       String
  summary       String?
  status        String?
  priority      String?
  url           String?
  createdAt     DateTime @default(now())

  testCase SitTestCase @relation(fields: [sitTestCaseId], references: [id], onDelete: Cascade)

  @@index([sitTestCaseId])
  @@index([jiraKey])
}

model SitTaskHistory {
  id        String           @id @default(cuid())
  sitTaskId String
  actorId   String?
  action    SitHistoryAction
  message   String
  before    Json?
  after     Json?
  createdAt DateTime         @default(now())

  sitTask SitTask @relation(fields: [sitTaskId], references: [id], onDelete: Cascade)
  actor   User?   @relation("SitHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([sitTaskId, createdAt])
}

model DraftTask {
  id              String          @id @default(cuid())
  jiraTicket      String          @unique
  productId       String
  status          DraftTaskStatus @default(PENDING)
  rawExcelData    Json
  generatedData   Json
  editedData      Json?
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  resultTaskIds   String[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  product      Product @relation(fields: [productId], references: [id])
  reviewedBy   User?   @relation("DraftTaskReviewedBy", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
}
